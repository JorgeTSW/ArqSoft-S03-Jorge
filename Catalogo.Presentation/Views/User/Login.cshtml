@{
    ViewData["Title"] = "Iniciar sesión";
}

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 900px; margin: 3rem auto;">

    <!-- COLUMNA IZQUIERDA — Formulario -->
    <div>
        <h1>Iniciar sesión</h1>
        <p style="color: var(--color-texto-suave); margin-bottom: 2rem;">
            Accede a tu cuenta para dejar reseñas.
        </p>

        @if (ViewBag.Error != null)
        {
            <p style="color: var(--neon-secundario);">
                <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error
            </p>
        }

        <form asp-action="Login" method="post">
            <div style="margin-bottom: 1rem;">
                <input class="form-control" type="email" name="email" placeholder="Email" required />
            </div>
            <div style="margin-bottom: 1.5rem;">
                <input class="form-control" type="password" name="password" placeholder="Contraseña" required />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; font-size: 1rem;">
                <i class="fa-solid fa-right-to-bracket"></i> ENTRAR
            </button>
        </form>
    </div>

    <!-- COLUMNA DERECHA — Registro -->
    <div style="display: flex; flex-direction: column; justify-content: center;">
        <h2>¿Primera vez aquí?</h2>
        <p style="color: var(--color-texto); margin-bottom: 1.5rem;">
            Crea tu cuenta y empieza a calificar tus videojuegos favoritos.
            El registro es gratuito y solo toma un momento.
        </p>
        <a asp-action="Register" class="btn btn-outline-primary" style="width: fit-content; padding: 0.6rem 2rem;">
            <i class="fa-solid fa-user-plus"></i> Crear cuenta
        </a>
    </div>

</div>