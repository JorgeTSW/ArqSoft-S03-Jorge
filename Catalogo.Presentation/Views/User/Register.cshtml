@model CatalogoApp.Domain.Models.User
@{
    ViewData["Title"] = "Registro";
}

<h2>Crear cuenta</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}

<form asp-action="Register" method="post">
    <div>
        <label>Nombre</label>
        <input asp-for="Nombre" required />
    </div>
    <div>
        <label>Email</label>
        <input asp-for="Email" type="email" required />
    </div>
    <div>
        <label>Contraseña</label>
        <input asp-for="Password" type="password" required />
    </div>
    <br />
    <button type="submit">Registrarse</button>
</form>

<hr />
<a asp-action="Login">¿Ya tienes cuenta? Inicia sesión</a>