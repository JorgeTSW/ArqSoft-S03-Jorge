@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO -->
<div style="text-align: center; padding: 4rem 1rem 3rem;">
    <h1 style="font-family: var(--fuente-titulo); font-size: 2rem; margin-bottom: 1.5rem;">
        CATÁLOGO DE VIDEOJUEGOS
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-texto); max-width: 600px; margin: 0 auto;">
        ¡Hola! Te presento mi colección personal de mis videojuegos favoritos de toda la vida.
        Puedes explorar por género, dejar tu reseña y descubrir joyas clásicas.
    </p>
</div>

<hr />

<!-- QUÉ ES -->
<div style="max-width: 800px; margin: 2rem auto;">
    <h2>¿Qué es esto?</h2>
    <p>
        Esta app es un catálogo personal en donde puedes explorar mis videojuegos favoritos,
        organizados por género y consola. También puedes leer y escribir reseñas, y descubrir 
        títulos que me marcaron de por vida.
    </p>
</div>