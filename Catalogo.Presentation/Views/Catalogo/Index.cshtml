@model IEnumerable<CatalogoApp.Domain.Models.Item>

<h1>Mi Catálogo</h1>

<div>
    <a asp-action="Index">Todos</a>
    @foreach (var gen in ViewBag.Generos as List<string>)
    {
        <span> | </span>
        <a asp-action="Index" asp-route-genero="@gen">@gen</a>
    }
</div>

<hr />

<ul>
    @foreach (var item in Model)
    {
        <li>
            <a asp-action="Detalle" asp-route-id="@item.Id">@item.Titulo</a>
            — @item.Genero (@item.Ano)
        </li>
    }
</ul>

<hr />
@if (Context.Session.GetString("UserNombre") != null)
{
    <a asp-action="Agregar">+ Agregar Videojuego</a>
}